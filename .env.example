# Copy to .env for local `vercel dev` and for scripts/migrate-games-json.mjs.
# .env is gitignored. Never commit real values.

# Supabase project URL — the same value as SUPABASE_URL in js/config.js.
SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key. Server-side only: read by /api/sync/* and the migration
# script. It bypasses row-level security, so it must never reach the browser
# or this repo.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. BGG has announced that the XML API will require a registered
# application token; when set it is sent as `Authorization: Bearer …` on every
# BGG request. Leave empty until you have one.
BGG_API_TOKEN=

# Optional, migration script only. Absolute origin used to turn a local
# /covers/<id>.jpg into a full URL for games.thumbnail_url. Defaults to
# https://boardgameshelf.vercel.app when unset.
SITE_URL=
