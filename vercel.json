{
  "images": {
    "sizes": [160, 384, 1080],
    "domains": ["cf.geekdo-images.com"],
    "minimumCacheTTL": 2592000,
    "formats": ["image/avif", "image/webp"]
  },
  "headers": [
    {
      "source": "/covers/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/",                  "destination": "/landing-next.html" },
    { "source": "/u/:slug",           "destination": "/shelf.html" },
    { "source": "/bag/:id",           "destination": "/shelf.html" },
    { "source": "/settings",          "destination": "/settings.html" },
    { "source": "/shelf",             "destination": "/shelf.html" },
    { "source": "/welcome",           "destination": "/welcome.html" },
    { "source": "/privacy",           "destination": "/privacy.html" },
    { "source": "/terms",             "destination": "/terms.html" },
    { "source": "/night/:code/host",  "destination": "/night-host.html" },
    { "source": "/vote/:code",        "destination": "/vote.html" },
    { "source": "/vote/:code/swipe",  "destination": "/vote-swipe.html" },
    { "source": "/results/:code",     "destination": "/results.html" },
    { "source": "/tv",                "destination": "/tv.html" },
    { "source": "/tv/:code",          "destination": "/tv.html" }
  ]
}
